# =====================================================================
# X (Twitter) API v2 認証情報
# ---------------------------------------------------------------------
# リンククリック数(url_link_clicks)などの non_public_metrics を取得するには
# OAuth 1.0a ユーザーコンテキスト認証（下記4点）が必須です。
# X Developer Portal の対象アプリで発行してください。
#   - App の権限は「Read」以上
#   - Access Token / Secret は「自分のアカウント」で発行したもの
# =====================================================================
X_API_KEY=your_consumer_api_key_here
X_API_SECRET=your_consumer_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# 任意: public_metrics のみでよい場合のフォールバック用（App-only Bearer）。
# 上記4点があれば不要です。
X_API_BEARER_TOKEN=

# 任意: 対象アカウントを user_id で明示したい場合（未指定なら認証ユーザー＝get_me()）。
X_TARGET_USER_ID=

# 任意: 初回実行（履歴なし）のときだけ使う、遡って取得するツイート件数（5〜100、既定 50）。
# 2回目以降は「前回取得以降の新規」＋ X_REFRESH_COUNT 件の既存投稿再取得に切り替わるため使われない。
X_MAX_RESULTS=50

# 任意: 2回目以降の日次実行で、インプレッションの伸びを追跡するために
# 再取得する「既存投稿の直近件数」（0〜100、既定 15）。
X_REFRESH_COUNT=15

# =====================================================================
# Claude API（フェーズ2: 月次分析で使用）
# =====================================================================
ANTHROPIC_API_KEY=

# 任意: 月次分析に使うClaudeのモデル名（既定: claude-sonnet-5）。
ANTHROPIC_MODEL=

# =====================================================================
# Slack Incoming Webhook（フェーズ2: 月次サマリ投稿で使用）
# 投稿先チャンネルは Webhook URL 発行時に Slack 側で指定されるため、
# ここではURLのみ設定する。
# =====================================================================
SLACK_WEBHOOK_URL=

# =====================================================================
# SQLite データベースのパス（既定: data/impressions.db）
# =====================================================================
DB_PATH=data/impressions.db

# 任意: 月次分析レポートの保存先ディレクトリ（既定: data/reports）
REPORTS_DIR=data/reports
